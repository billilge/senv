{
  "name": "stream-env-control",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify": "biome check . && turbo run typecheck build test",
    "smoke:docker": "bash scripts/docker-smoke.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  }
}

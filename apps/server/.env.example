# Stream Env Control 서버 환경변수 예시
# 로컬에서는 이 파일을 .env 로 복사해 값을 채운다. 실제 값이 든 .env 는 커밋하지 않는다.
# 운영에서는 이 값들을 Coolify 환경변수에 직접 넣는다 (PRD 4.5). 이 시스템이 관리하는 값이 아니다.

# ── 서버 ─────────────────────────────────────────────
# 비우면 3000
PORT=3000
# 대시보드 기준 주소. GitHub OAuth 콜백 주소({APP_URL}/auth/github/callback)를 만들 때 쓴다.
# https만 허용하고, 로컬 개발용 http://localhost 만 예외다.
# 운영: https://senv.stream.billilge.site
APP_URL=http://localhost:3000

# ── DB: 기존 MySQL 리소스의 stream_env 데이터베이스 ─────
# 운영: Coolify MySQL 리소스의 내부 주소. stream_env 전용 계정을 쓴다.
DATABASE_URL=mysql://stream_env:change-me@localhost:3306/stream_env

# ── 스냅샷 저장소 (S3 호환) ──────────────────────────
# 운영: https://<account_id>.r2.cloudflarestorage.com (버킷 stream-env 전용 API 토큰)
# 로컬: S3 호환 저장소 주소
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET=stream-env

# ── 암호화 마스터 키 (KEK) ────────────────────────────
# 생성: openssl rand -base64 32  (32바이트, base64)
# 잃어버리면 저장된 모든 스냅샷을 복구할 수 없다. 운영 키는 관리자 2명이 서버 밖에 따로 보관한다.
SENV_KEK=
SENV_KEK_ID=kek-local
# KEK 교체 중일 때만 채운다: 이전 키들을 "id:base64,id:base64" 형식으로
SENV_KEK_PREVIOUS=

# ── 대시보드 세션 ────────────────────────────────────
# 32자 이상. 생성: openssl rand -base64 32
SESSION_SECRET=

# ── GitHub OAuth ────────────────────────────────────
# OAuth App은 콜백 주소를 하나만 받으므로, 로컬 개발용 OAuth App을 따로 만든다.
#   운영 앱 콜백: https://senv.stream.billilge.site/auth/github/callback
#   로컬 앱 콜백: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 로그인을 허용할 GitHub 조직. 이 org의 활성 멤버만 로그인할 수 있다.
GITHUB_ORG=billilge

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

/// M1은 두 단계만 둔다. 프로젝트 × 환경 세부 권한은 M2 (PRD 9.3)
enum UserRole {
  admin
  member
}

enum UserStatus {
  /// 로그인은 했지만 관리자가 아직 승인하지 않음
  pending
  active
  disabled
}

model User {
  id           String        @id @default(uuid(7)) @db.Char(36)
  /// GitHub 숫자 ID. 사용자명은 바뀔 수 있어 이 값으로 식별한다
  githubId     String        @unique @map("github_id") @db.VarChar(20)
  login        String        @db.VarChar(39)
  name         String?       @db.VarChar(255)
  avatarUrl    String?       @map("avatar_url") @db.VarChar(512)
  role         UserRole      @default(member)
  status       UserStatus    @default(pending)
  createdAt    DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  lastLoginAt  DateTime?     @map("last_login_at") @db.DateTime(3)
  sessions     Session[]
  apiTokens    ApiToken[]
  deviceCodes  DeviceCode[]
  agentDevices AgentDevice[]

  @@map("users")
}

enum DeviceCodeStatus {
  pending
  approved
  denied
  /// 토큰을 이미 받아 갔다
  consumed
}

/// CLI 디바이스 로그인 대기 상태 (RFC 8628)
model DeviceCode {
  id              String           @id @default(uuid(7)) @db.Char(36)
  /// CLI가 폴링할 때 쓰는 비밀 값의 해시
  deviceCodeHash  String           @unique @map("device_code_hash") @db.Char(64)
  /// 사용자가 브라우저에 입력하는 코드 (하이픈 없이 저장)
  userCode        String           @unique @map("user_code") @db.Char(8)
  status          DeviceCodeStatus @default(pending)
  userId          String?          @map("user_id") @db.Char(36)
  intervalSeconds Int              @map("interval_seconds")
  lastPolledAt    DateTime?        @map("last_polled_at") @db.DateTime(3)
  createdAt       DateTime         @map("created_at") @db.DateTime(3)
  expiresAt       DateTime         @map("expires_at") @db.DateTime(3)
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_codes")
}

enum ApiTokenKind {
  access
  refresh
  service
}

/// CLI·CI가 쓰는 토큰. 원문은 발급할 때 한 번만 주고 DB에는 해시만 둔다
model ApiToken {
  id        String       @id @default(uuid(7)) @db.Char(36)
  userId    String       @map("user_id") @db.Char(36)
  kind      ApiTokenKind
  tokenHash String       @unique @map("token_hash") @db.Char(64)
  createdAt DateTime     @map("created_at") @db.DateTime(3)
  expiresAt DateTime     @map("expires_at") @db.DateTime(3)
  /// 폐기되었거나, refresh 토큰이면 이미 한 번 쓰였음. 재사용 감지를 위해 행은 남긴다
  revokedAt DateTime?    @map("revoked_at") @db.DateTime(3)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

/// 대시보드 세션. 쿠키에는 원문 토큰, DB에는 해시만 둔다
model Session {
  id         String   @id @default(uuid(7)) @db.Char(36)
  userId     String   @map("user_id") @db.Char(36)
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime @map("created_at") @db.DateTime(3)
  lastUsedAt DateTime @map("last_used_at") @db.DateTime(3)
  /// 마지막 사용 후 7일. 쓸 때마다 연장한다 (PRD 9.2)
  expiresAt  DateTime @map("expires_at") @db.DateTime(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum ProjectKind {
  app
  shared
}

/// 환경은 세 개로 고정 (PRD 5.1)
enum EnvironmentName {
  local
  development
  production
}

model Project {
  id             String          @id @default(uuid(7)) @db.Char(36)
  /// 소문자·숫자·하이픈, 32자 이하. R2 경로와 CLI 인자에 그대로 쓴다
  name           String          @unique @db.VarChar(32)
  displayName    String          @map("display_name") @db.VarChar(100)
  kind           ProjectKind     @default(app)
  /// 클라이언트 번들에 들어가는 키의 접두사, 쉼표로 구분 (예: VITE_). 노출 검사에 쓴다 (PRD 6.3)
  publicPrefixes String          @default("") @map("public_prefixes") @db.VarChar(200)
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  environments   Environment[]
  keySchemas     KeySchema[]
  targets        TargetMapping[]
  localLinks     LocalLink[]

  @@map("projects")
}

model Environment {
  id             String               @id @default(uuid(7)) @db.Char(36)
  projectId      String               @map("project_id") @db.Char(36)
  name           EnvironmentName
  /// 현재 게시된 버전. 0이면 아직 게시한 적이 없다 (PRD 5.4)
  currentVersion Int                  @default(0) @map("current_version")
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions       EnvironmentVersion[]

  @@unique([projectId, name])
  @@map("environments")
}

/// 게시할 때마다 한 줄. 값은 R2 스냅샷에 있고 여기에는 메타데이터만 둔다
model EnvironmentVersion {
  id            String      @id @default(uuid(7)) @db.Char(36)
  environmentId String      @map("environment_id") @db.Char(36)
  version       Int
  /// 게시한 사용자 또는 토큰 식별자. 사용자가 지워져도 기록은 남도록 외래 키를 걸지 않는다
  createdBy     String      @map("created_by") @db.VarChar(64)
  message       String      @db.VarChar(500)
  /// 이 버전의 키 이름 목록(쉼표로 구분). 값은 담지 않는다. 목록 요약에 쓰고, 없으면 스냅샷에서 읽는다
  keyNames      String?     @map("key_names") @db.Text
  createdAt     DateTime    @map("created_at") @db.DateTime(3)
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, version])
  @@map("env_versions")
}

enum VariableType {
  string
  url
  number
  boolean
  json
}

enum Visibility {
  /// 가려서 보여주고, 클라이언트 번들에 들어가면 안 되는 값
  secret
  /// 클라이언트 번들에 들어가도 되는 값
  public
}

/// 프로젝트 공통 키 스키마 (PRD 5.2). 값은 환경별 스냅샷에, 속성은 여기에 둔다
model KeySchema {
  id          String       @id @default(uuid(7)) @db.Char(36)
  projectId   String       @map("project_id") @db.Char(36)
  key         String       @db.VarChar(128)
  type        VariableType @default(string)
  visibility  Visibility   @default(secret)
  required    Boolean      @default(false)
  /// required여도 값이 없어도 되는 환경, 쉼표로 구분 (예: local,development)
  optionalIn  String       @default("") @map("optional_in") @db.VarChar(64)
  buildTime   Boolean      @default(false) @map("build_time")
  description String       @default("") @db.VarChar(500)
  updatedAt   DateTime     @map("updated_at") @db.DateTime(3)
  /// 마지막으로 고친 사용자. 사용자가 지워져도 남도록 외래 키를 걸지 않는다
  updatedBy   String       @map("updated_by") @db.VarChar(64)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@map("key_schemas")
}

/// 아직 로그인하지 않은 GitHub 사용자에게 미리 정해 둔 역할 (PRD 7.1).
/// 그 사용자가 처음 로그인하면 승인 대기 없이 이 역할로 활성화되고, 이 행은 지운다
model RoleAssignment {
  /// GitHub 사용자명 (소문자)
  login     String   @id @db.VarChar(39)
  role      UserRole
  createdBy String   @map("created_by") @db.VarChar(64)
  createdAt DateTime @map("created_at") @db.DateTime(3)

  @@map("role_assignments")
}

enum SyncMode {
  /// 게시하면 자동으로 반영한다 (기본)
  auto
  /// 대시보드에서 계획을 확인하고 버튼으로 반영한다
  manual
}

enum AfterSync {
  /// 바뀐 키에 빌드 시점 값이 있으면 재배포, 아니면 재시작
  auto
  none
  restart
  redeploy
}

enum UnmanagedKeys {
  keep
  delete
}

enum SyncTrigger {
  publish
  manual
}

enum SyncStatus {
  succeeded
  /// 바뀐 값이 없어 아무것도 하지 않음
  skipped
  failed
}

enum JobStatus {
  pending
  running
  done
  failed
}

/// 배포 대상 연결 (PRD 8.1). 설정(자격 증명 포함)은 KEK 봉투로 암호화해 둔다
model TargetConnection {
  id        String          @id @db.Char(36)
  name      String          @unique @db.VarChar(64)
  /// 제공자 종류 (예: coolify)
  type      String          @db.VarChar(32)
  /// 봉투 암호화한 연결 설정 JSON. 연결 id를 AAD에 묶는다
  config    String          @db.Text
  createdBy String          @map("created_by") @db.VarChar(64)
  createdAt DateTime        @map("created_at") @db.DateTime(3)
  updatedAt DateTime        @map("updated_at") @db.DateTime(3)
  mappings  TargetMapping[]

  @@map("target_connections")
}

/// (프로젝트, 환경) → 배포 대상 리소스 (PRD 8.1)
model TargetMapping {
  id                      String           @id @default(uuid(7)) @db.Char(36)
  connectionId            String           @map("connection_id") @db.Char(36)
  projectId               String           @map("project_id") @db.Char(36)
  env                     EnvironmentName
  resourceId              String           @map("resource_id") @db.VarChar(128)
  resourceName            String           @map("resource_name") @db.VarChar(255)
  syncMode                SyncMode         @default(auto) @map("sync_mode")
  afterSync               AfterSync        @default(auto) @map("after_sync")
  unmanaged               UnmanagedKeys    @default(keep)
  /// 포함·제외 키 패턴, 쉼표로 구분 (예: SENTRY_*)
  include                 String           @default("") @db.VarChar(500)
  exclude                 String           @default("") @db.VarChar(500)
  /// 제공자 전용 매핑 옵션 JSON
  options                 String           @default("{}") @db.VarChar(2000)
  /// 마지막으로 반영한 값의 키별 해시 JSON. 값 자체는 남기지 않는다 (드리프트 감지)
  lastSyncedHashes        String?          @map("last_synced_hashes") @db.Text
  lastSyncedVersion       Int?             @map("last_synced_version")
  lastSyncedSharedVersion Int?             @map("last_synced_shared_version")
  lastSyncedAt            DateTime?        @map("last_synced_at") @db.DateTime(3)
  /// 인프라에서 직접 바뀐 키, 쉼표로 구분
  driftKeys               String?          @map("drift_keys") @db.Text
  driftCheckedAt          DateTime?        @map("drift_checked_at") @db.DateTime(3)
  createdAt               DateTime         @map("created_at") @db.DateTime(3)
  updatedAt               DateTime         @map("updated_at") @db.DateTime(3)
  connection              TargetConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  project                 Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs                    SyncRun[]

  @@unique([connectionId, resourceId])
  @@index([projectId, env])
  @@map("target_mappings")
}

/// 동기화 기록 (PRD 8.2). 바뀐 키 이름만 남기고 값은 남기지 않는다
model SyncRun {
  id            String        @id @default(uuid(7)) @db.Char(36)
  mappingId     String        @map("mapping_id") @db.Char(36)
  trigger       SyncTrigger
  status        SyncStatus
  version       Int
  sharedVersion Int           @map("shared_version")
  /// 바뀐 키 이름, 쉼표로 구분
  changedKeys   String        @map("changed_keys") @db.Text
  action        String?       @db.VarChar(16)
  /// 제공자가 돌려준 참조 (예: Coolify deployment_uuid)
  providerRef   String?       @map("provider_ref") @db.VarChar(128)
  error         String?       @db.VarChar(1000)
  attempt       Int           @default(1)
  actor         String?       @db.VarChar(64)
  startedAt     DateTime      @map("started_at") @db.DateTime(3)
  finishedAt    DateTime      @map("finished_at") @db.DateTime(3)
  mapping       TargetMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  @@index([mappingId, startedAt])
  @@map("sync_runs")
}

/// 작업 큐 (PRD 4.4). worker가 SKIP LOCKED로 가져간다
model Job {
  id          String    @id @default(uuid(7)) @db.Char(36)
  type        String    @db.VarChar(32)
  payload     String    @db.Text
  /// 같은 키의 대기 작업은 새 작업으로 대체한다 (예: sync:{mappingId})
  dedupeKey   String?   @map("dedupe_key") @db.VarChar(128)
  status      JobStatus @default(pending)
  runAt       DateTime  @map("run_at") @db.DateTime(3)
  lockedUntil DateTime? @map("locked_until") @db.DateTime(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.VarChar(1000)
  createdAt   DateTime  @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @map("updated_at") @db.DateTime(3)

  @@index([status, runAt])
  @@index([dedupeKey])
  @@map("jobs")
}

/// 로컬 자동 받기 에이전트(senv agent)가 도는 PC (M1.1, PRD 결정 60). CLI 로그인용 DeviceCode와는 다르다
model AgentDevice {
  id         String      @id @default(uuid(7)) @db.Char(36)
  userId     String      @map("user_id") @db.Char(36)
  /// 호스트 이름 (표시용)
  name       String      @db.VarChar(100)
  createdAt  DateTime    @map("created_at") @db.DateTime(3)
  /// 에이전트가 마지막으로 연결을 조회한 시각
  lastSeenAt DateTime?   @map("last_seen_at") @db.DateTime(3)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  links      LocalLink[]

  @@index([userId])
  @@map("agent_devices")
}

enum LocalLinkStatus {
  /// 대시보드에서 만들었고 PC 승인을 기다린다 (결정 61)
  pending
  active
  paused
}

/// 에이전트가 보고한 마지막 상태 (core LOCAL_LINK_STATES)
enum LocalLinkState {
  ok
  no_config
  project_mismatch
  not_ignored
  symlink
  modified
  exposure
  error
}

/// 기기의 폴더에 local 값을 쓰는 연결 (M1.1, PRD 결정 60~62). 환경은 local로 고정한다.
/// 파일 내용의 해시는 기기에만 두고 여기에는 버전만 남긴다
model LocalLink {
  id                       String          @id @default(uuid(7)) @db.Char(36)
  deviceId                 String          @map("device_id") @db.Char(36)
  projectId                String          @map("project_id") @db.Char(36)
  /// 기기의 절대 경로 (senv.json이 있는 폴더). 유일 인덱스가 MySQL 한도(3072바이트)를 넘지 않게 512자로 둔다
  path                     String          @db.VarChar(512)
  status                   LocalLinkStatus @default(pending)
  approvedAt               DateTime?       @map("approved_at") @db.DateTime(3)
  lastWrittenVersion       Int?            @map("last_written_version")
  lastWrittenSharedVersion Int?            @map("last_written_shared_version")
  lastWrittenAt            DateTime?       @map("last_written_at") @db.DateTime(3)
  lastState                LocalLinkState? @map("last_state")
  /// 상태 설명. 값은 담지 않는다
  lastMessage              String?         @map("last_message") @db.VarChar(300)
  lastStateAt              DateTime?       @map("last_state_at") @db.DateTime(3)
  /// 대시보드에서 "덮어쓰기"를 누른 시각. 에이전트가 쓰면 지운다
  overwriteRequestedAt     DateTime?       @map("overwrite_requested_at") @db.DateTime(3)
  createdAt                DateTime        @map("created_at") @db.DateTime(3)
  updatedAt                DateTime        @map("updated_at") @db.DateTime(3)
  device                   AgentDevice     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  project                  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([deviceId, path])
  @@index([projectId])
  @@map("local_links")
}

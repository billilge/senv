generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum ProjectKind {
  app
  shared
}

/// 환경은 세 개로 고정 (PRD 5.1)
enum EnvironmentName {
  local
  development
  production
}

model Project {
  id           String        @id @default(uuid(7)) @db.Char(36)
  /// 소문자·숫자·하이픈, 32자 이하. R2 경로와 CLI 인자에 그대로 쓴다
  name         String        @unique @db.VarChar(32)
  displayName  String        @map("display_name") @db.VarChar(100)
  kind         ProjectKind   @default(app)
  createdAt    DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  environments Environment[]

  @@map("projects")
}

model Environment {
  id             String               @id @default(uuid(7)) @db.Char(36)
  projectId      String               @map("project_id") @db.Char(36)
  name           EnvironmentName
  /// 현재 게시된 버전. 0이면 아직 게시한 적이 없다 (PRD 5.4)
  currentVersion Int                  @default(0) @map("current_version")
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions       EnvironmentVersion[]

  @@unique([projectId, name])
  @@map("environments")
}

/// 게시할 때마다 한 줄. 값은 R2 스냅샷에 있고 여기에는 메타데이터만 둔다
model EnvironmentVersion {
  id            String      @id @default(uuid(7)) @db.Char(36)
  environmentId String      @map("environment_id") @db.Char(36)
  version       Int
  /// 게시한 사용자 또는 토큰 식별자. 사용자가 지워져도 기록은 남도록 외래 키를 걸지 않는다
  createdBy     String      @map("created_by") @db.VarChar(64)
  message       String      @db.VarChar(500)
  createdAt     DateTime    @map("created_at") @db.DateTime(3)
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, version])
  @@map("env_versions")
}

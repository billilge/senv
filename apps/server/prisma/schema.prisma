generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

/// M1은 두 단계만 둔다. 프로젝트 × 환경 세부 권한은 M2 (PRD 9.3)
enum UserRole {
  admin
  member
}

enum UserStatus {
  /// 로그인은 했지만 관리자가 아직 승인하지 않음
  pending
  active
  disabled
}

model User {
  id          String       @id @default(uuid(7)) @db.Char(36)
  /// GitHub 숫자 ID. 사용자명은 바뀔 수 있어 이 값으로 식별한다
  githubId    String       @unique @map("github_id") @db.VarChar(20)
  login       String       @db.VarChar(39)
  name        String?      @db.VarChar(255)
  avatarUrl   String?      @map("avatar_url") @db.VarChar(512)
  role        UserRole     @default(member)
  status      UserStatus   @default(pending)
  createdAt   DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  lastLoginAt DateTime?    @map("last_login_at") @db.DateTime(3)
  sessions    Session[]
  apiTokens   ApiToken[]
  deviceCodes DeviceCode[]

  @@map("users")
}

enum DeviceCodeStatus {
  pending
  approved
  denied
  /// 토큰을 이미 받아 갔다
  consumed
}

/// CLI 디바이스 로그인 대기 상태 (RFC 8628)
model DeviceCode {
  id              String           @id @default(uuid(7)) @db.Char(36)
  /// CLI가 폴링할 때 쓰는 비밀 값의 해시
  deviceCodeHash  String           @unique @map("device_code_hash") @db.Char(64)
  /// 사용자가 브라우저에 입력하는 코드 (하이픈 없이 저장)
  userCode        String           @unique @map("user_code") @db.Char(8)
  status          DeviceCodeStatus @default(pending)
  userId          String?          @map("user_id") @db.Char(36)
  intervalSeconds Int              @map("interval_seconds")
  lastPolledAt    DateTime?        @map("last_polled_at") @db.DateTime(3)
  createdAt       DateTime         @map("created_at") @db.DateTime(3)
  expiresAt       DateTime         @map("expires_at") @db.DateTime(3)
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_codes")
}

enum ApiTokenKind {
  access
  refresh
  service
}

/// CLI·CI가 쓰는 토큰. 원문은 발급할 때 한 번만 주고 DB에는 해시만 둔다
model ApiToken {
  id        String       @id @default(uuid(7)) @db.Char(36)
  userId    String       @map("user_id") @db.Char(36)
  kind      ApiTokenKind
  tokenHash String       @unique @map("token_hash") @db.Char(64)
  createdAt DateTime     @map("created_at") @db.DateTime(3)
  expiresAt DateTime     @map("expires_at") @db.DateTime(3)
  /// 폐기되었거나, refresh 토큰이면 이미 한 번 쓰였음. 재사용 감지를 위해 행은 남긴다
  revokedAt DateTime?    @map("revoked_at") @db.DateTime(3)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

/// 대시보드 세션. 쿠키에는 원문 토큰, DB에는 해시만 둔다
model Session {
  id         String   @id @default(uuid(7)) @db.Char(36)
  userId     String   @map("user_id") @db.Char(36)
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime @map("created_at") @db.DateTime(3)
  lastUsedAt DateTime @map("last_used_at") @db.DateTime(3)
  /// 마지막 사용 후 7일. 쓸 때마다 연장한다 (PRD 9.2)
  expiresAt  DateTime @map("expires_at") @db.DateTime(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum ProjectKind {
  app
  shared
}

/// 환경은 세 개로 고정 (PRD 5.1)
enum EnvironmentName {
  local
  development
  production
}

model Project {
  id             String        @id @default(uuid(7)) @db.Char(36)
  /// 소문자·숫자·하이픈, 32자 이하. R2 경로와 CLI 인자에 그대로 쓴다
  name           String        @unique @db.VarChar(32)
  displayName    String        @map("display_name") @db.VarChar(100)
  kind           ProjectKind   @default(app)
  /// 클라이언트 번들에 들어가는 키의 접두사, 쉼표로 구분 (예: VITE_). 노출 검사에 쓴다 (PRD 6.3)
  publicPrefixes String        @default("") @map("public_prefixes") @db.VarChar(200)
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  environments   Environment[]
  keySchemas     KeySchema[]

  @@map("projects")
}

model Environment {
  id             String               @id @default(uuid(7)) @db.Char(36)
  projectId      String               @map("project_id") @db.Char(36)
  name           EnvironmentName
  /// 현재 게시된 버전. 0이면 아직 게시한 적이 없다 (PRD 5.4)
  currentVersion Int                  @default(0) @map("current_version")
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions       EnvironmentVersion[]

  @@unique([projectId, name])
  @@map("environments")
}

/// 게시할 때마다 한 줄. 값은 R2 스냅샷에 있고 여기에는 메타데이터만 둔다
model EnvironmentVersion {
  id            String      @id @default(uuid(7)) @db.Char(36)
  environmentId String      @map("environment_id") @db.Char(36)
  version       Int
  /// 게시한 사용자 또는 토큰 식별자. 사용자가 지워져도 기록은 남도록 외래 키를 걸지 않는다
  createdBy     String      @map("created_by") @db.VarChar(64)
  message       String      @db.VarChar(500)
  createdAt     DateTime    @map("created_at") @db.DateTime(3)
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, version])
  @@map("env_versions")
}

enum VariableType {
  string
  url
  number
  boolean
  json
}

enum Visibility {
  /// 가려서 보여주고, 클라이언트 번들에 들어가면 안 되는 값
  secret
  /// 클라이언트 번들에 들어가도 되는 값
  public
}

/// 프로젝트 공통 키 스키마 (PRD 5.2). 값은 환경별 스냅샷에, 속성은 여기에 둔다
model KeySchema {
  id          String       @id @default(uuid(7)) @db.Char(36)
  projectId   String       @map("project_id") @db.Char(36)
  key         String       @db.VarChar(128)
  type        VariableType @default(string)
  visibility  Visibility   @default(secret)
  required    Boolean      @default(false)
  /// required여도 값이 없어도 되는 환경, 쉼표로 구분 (예: local,development)
  optionalIn  String       @default("") @map("optional_in") @db.VarChar(64)
  buildTime   Boolean      @default(false) @map("build_time")
  description String       @default("") @db.VarChar(500)
  updatedAt   DateTime     @map("updated_at") @db.DateTime(3)
  /// 마지막으로 고친 사용자. 사용자가 지워져도 남도록 외래 키를 걸지 않는다
  updatedBy   String       @map("updated_by") @db.VarChar(64)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@map("key_schemas")
}
